 "transaction_rules": {
  "prefix": "byte sent with parity none; ECU answers with bitwise complement (tx XOR FF); mismatch => abort",
  "selector": "byte sent with parity space after a read prefix (20/21/24/27/F0/F1); ECU answers with one data byte",
  "write_argument": "byte sent with parity space after a control/clear prefix; ECU answers with complement of the argument (FF->00, FC->03, 00->FF) [inference from expected values]",
  "context": "the ECU keeps the last read prefix as context: selector-only recipes (e.g. B9 B7, 96) rely on the previous prefix",
  "echo": "every TX byte is first read back (adapter echo) and must match",
